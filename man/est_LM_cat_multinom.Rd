\name{est_LM_cat_multinom}

\alias{est_LM_cat_multinom}

\title{Estimation of Constrained Hidden Markov Models}

\description{Function that estimates a hidden Markov model to a univariate categorical longitudinal response.
The observed response is generated by an unobserved first-order Markov chain
with \code{k} latent states. Conditional on the latent state, responses are
independent over time. Covariates may affect both the initial latent-state
probabilities and the transition probabilities, and linear equality
constraints may be imposed separately on transition intercepts and covariate
effects.}

\usage{
est_LM_cat_multinom(resp_name, formula, k, data, reltol = 10^-10,
                    rand.start = FALSE,
                    nstart = 1, baseline = c("initial", "central"),
                    model_int = c("all", "const", "dist1", "dist2",
                                  "dist3", "two", "symm", "rsymm", "diff"),
                    model_cov = c("all", "const", "dist1", "dist2", "dist3",
                                  "two", "symm", "rsymm", "diff"),
                    formula_init = NULL,
                    par.init = list(la = NULL, psi = NULL, Pr = NULL),
                    output = FALSE, fort = TRUE)
}

\arguments{
\item{resp_name }{
  Character string giving the name of the observed response variable in
    \code{data}. The response must be numeric and coded with consecutive
    integer categories \code{1, ..., c}, where \code{c} is the number of 
    response categories, with no missing categories.
  }
\item{formula }{
  A one-sided formula specifying the covariates in the transition model,
    for example \code{~ gender + race + education + age_c}. An intercept
    should be included. If \code{formula_init} is \code{NULL}, the same
    covariates are used for the initial latent-state probabilities.
  }
\item{k }{
  Positive integer giving the number of latent states. A one-state model is
    allowed; in that case only the response probabilities and fit criteria are
    estimated, and the arguments \code{formula}, \code{formula_init}, 
    \code{baseline}, \code{model_int} and \code{model_cov} have no effect.
  }
\item{data }{
    Data frame in long format. The first column is used as the subject
    identifier and the second as the measurement occasion, irrespective of
    their names. Subject identifiers must be consecutive integers, records
    must be ordered by subject and occasion, and occasions for each subject
    must be consecutive and start at 1. Individual trajectories may have
    different lengths. Rows with missing values in the response or model
    variables should be removed before fitting.
  }
\item{reltol }{
    Positive numeric value giving the relative log-likelihood tolerance used
    to stop the EM algorithm. Iteration stops when the relative increment in
    log-likelihood is no greater than \code{reltol}.
  }
\item{rand.start }{
    Logical value controlling initialization when \code{nstart = 1}. If
    \code{FALSE}, the initial latent allocation is obtained by k-means
    clustering of the response. If \code{TRUE}, a random latent allocation is
    used. Components supplied in \code{par.init} override the corresponding
    internally generated starting values.
  }
\item{nstart }{
    Positive integer giving the number of fits from different starting
    values. If greater than 1, the first fit uses the k-means initialization
    and the remaining fits use random initial allocations; the fit with the
    largest log-likelihood is returned.
  }
\item{baseline }{
    Character string specifying the reference category in the multinomial 
    logit parameterization for the transition probabilities. With \code{"initial"}, 
    the transition towards the first state is used as the reference category 
    for each row of the transition matrix. With \code{"central"}, the self-transition 
    is used as the reference category for each row of the transition matrix.
  }
\item{model_int }{
    Character string specifying the equality-constraint structure for the
    transition-logit intercepts. Available choices are \code{"all"},
    \code{"const"}, \code{"dist1"}, \code{"dist2"}, \code{"dist3"},
    \code{"two"}, \code{"symm"}, \code{"rsymm"}, and \code{"diff"}.
    See Details and \code{\link{design_matrices}}.
  }
\item{model_cov }{
    Character string specifying the equality-constraint structure for the
    transition-logit regression coefficients. The available choices are the
    same as for \code{model_int}. See Details and
    \code{\link{design_matrices}}.
  }
\item{formula_init }{
    Optional one-sided formula specifying the covariates for the initial
    latent-state probabilities. Only measurements at occasion 1 are used. If
    \code{NULL}, \code{formula} is also used for this submodel. Use \code{~ 1}
    for an intercept-only initial-probability model.
  }
\item{par.init }{
Named list of optional starting values. Component \code{la} contains the
    coefficients for the initial-probability logits; \code{psi} contains the
    reduced parameter vector for the constrained transition logits; and
    \code{Pr} is a \code{k} by \code{c} matrix of conditional response
    probabilities. Any component may be left \code{NULL} to use an internally
    generated starting value.
  }
\item{output }{
Logical value. If \code{TRUE}, the fitted subject-specific initial
    probabilities \code{Piv} and transition probabilities \code{PI} are
    returned in addition to the main estimation results.
  }
\item{fort }{
Logical value selecting the numerical implementation. If \code{TRUE}, the
    compiled Fortran routines are used and must be available and loaded. If
    \code{FALSE}, the corresponding R routines are used.
  }
}

\details{
Let \eqn{U} denote the latent state for subject \eqn{i} at occasion
\eqn{t}. The measurement model is
\eqn{P(Y = y \mid U = u)}, represented by the returned
matrix \code{Pr}.
The arguments \code{model_int} and \code{model_cov} apply the same family of
constraint structures to different parameter blocks: \code{model_int} acts on
the transition intercepts, whereas \code{model_cov} acts componentwise on the
transition covariate coefficients. The two structures can be selected
independently. With \code{baseline = "central"}, let \eqn{a_{uv}} denote a
transition parameter from origin state \eqn{u} to destination state \eqn{v},
with \eqn{v \ne u}. The available structures are:

\describe{
  \item{\code{"all"}}{
    No equality constraints: every transition has its own parameter.
  }
  \item{\code{"const"}}{
    A common parameter is used for all off-diagonal transitions. For
    \code{model_cov}, each covariate therefore has one common effect across all
    transitions.
  }
  \item{\code{"dist1"}}{
    Parameters are grouped by signed displacement \eqn{v-u}. Transitions with
    the same direction and the same size of movement share a parameter.
  }
  \item{\code{"dist2"}}{
    Parameters are grouped by absolute displacement \eqn{|v-u|}; movements of
    the same size share a parameter in both directions.
  }
  \item{\code{"dist3"}}{
    Parameters depend on \eqn{|v-u|}, with opposite signs for upward and
    downward movements of the same size.
  }
  \item{\code{"two"}}{
    Two parameters are used: one for transitions with \eqn{v>u} and one for
    transitions with \eqn{v<u}, irrespective of movement size.
  }
  \item{\code{"symm"}}{
    Opposite transitions share a parameter, so that
    \eqn{a_{uv}=a_{vu}}.
  }
  \item{\code{"rsymm"}}{
    Opposite transitions have parameters with reversed signs, so that
    \eqn{a_{uv}=-a_{vu}}.
  }
  \item{\code{"diff"}}{
    Transition parameters are differences between destination- and
    origin-state parameters, \eqn{a_{uv}=a_v-a_u}, with the state-1 parameter
    fixed at zero for identifiability.
  }
}

The distance-based structures \code{"dist1"}, \code{"dist2"},
\code{"dist3"}, and \code{"two"} are intended for substantively ordered
latent states. In particular, \code{model_cov = "all"} is the unconstrained
transition-covariate model, \code{model_cov = "dist1"} pools effects by signed
displacement, and \code{model_cov = "const"} imposes one effect per covariate
across all transitions. The argument \code{model_int} operates analogously on
the transition intercepts.

When \code{nstart > 1}, the returned object is the solution with the largest
log-likelihood and component \code{lkv} records the log-likelihood obtained in
each fit. 
}
\value{
An object of class \code{"LM_cat_multinom"} containing:

\describe{
  \item{\code{Pr}}{A \code{k} by \code{c} matrix of estimated conditional response
    probabilities, with latent states in rows and observed categories in columns.}
  \item{\code{lk}}{The maximized observed-data log-likelihood.}
  \item{\code{np}}{The number of free model parameters.}
  \item{\code{aic}}{The Akaike information criterion.}
  \item{\code{bic}}{The Bayesian information criterion, using the number of
    subjects as the sample size.}
  \item{\code{call}}{The matched call used to fit the model.}
}

For \code{k > 1}, the object also contains:
\describe{
  \item{\code{la}}{
    Estimated regression coefficients for the initial latent-state
    probabilities.
  }
  \item{\code{psi}}{
    Estimated reduced parameter vector for the constrained transition logits.
  }
  \item{\code{eta}}{
    Expanded transition-logit parameter vector obtained by applying the design
    matrix constraints to \code{psi}.
  }
  \item{\code{W}}{
    Array of posterior latent-state probabilities produced by the final
    E-step, with dimensions \code{n} by \code{k} by \code{TT}, 
    where \code{n} is the number of subjects.
  }
  \item{\code{CL}}{
    Matrix of modal posterior latent-state classifications by subject and
    occasion, with dimensions \code{n} by \code{TT}.
  }
}

If \code{output = TRUE} and \code{k > 1}, it additionally contains:
\describe{
  \item{\code{Piv}}{
    Matrix of subject-specific fitted initial probabilities, with dimensions
    \code{n} by \code{k}.
  }
  \item{\code{PI}}{
    Array of subject- and occasion-specific fitted transition probabilities,
    with dimensions \code{k} by \code{k} by \code{n} by \code{TT}, where
    \code{TT} is the maximum number of occasions.
  }
}
If \code{nstart > 1}, component \code{lkv} contains the log-likelihood from
each attempted start.
}
\references{
Bartolucci, F., Pandolfi, S., and Pennoni, F. (2026).
Parsimonious parametrizations of transition matrices of Markov chain and
hidden Markov models. \emph{Annals of Operations Research}, \bold{363},
233--266.
}
\author{
Francesco Bartolucci and Silvia Pandolfi, University of Perugia (Italy);
Luca Brusa and Fulvia Pennoni, University of Milano-Bicocca (Italy).
}
\seealso{
\code{\link{design_matrices}}
}
\examples{
\dontrun{

# Load and prepare data

data("data_SRHS_long")
srhs <- data_SRHS_long[,c(2,1,3:7)]

# 1 = poor, ..., 5 = excellent
srhs$srhs1 <- 6L - as.integer(srhs$srhs)
srhs$gender <- factor(srhs$gender)
srhs$race <- factor(srhs$race)
srhs$education <- factor(srhs$education)
srhs$age_c <- srhs$age - mean(srhs$age)
srhs$id <- as.integer(factor(srhs$id))
srhs <- srhs[order(srhs$id, srhs$t), ]

# Reduce the sample size for fast example
set.seed(123)

all_ids <- unique(srhs$id)
n_example <- min(1000L, length(all_ids))
example_ids <- sample(all_ids, size = n_example, replace = FALSE)
srhs_example <- srhs[srhs$id \%in\% example_ids,,drop = FALSE]

# Consecutive identifiers required by the estimation function
srhs_example$id <- match(srhs_example$id, example_ids)
srhs_example <- srhs_example[order(srhs_example$id, srhs_example$t), ]

# Estimate a HM-ALL-COV: benchmark without constraints on covariate effects

hm_all <- est_LM_cat_multinom("srhs1", ~ gender + race + education + age_c,
                              k = 3, data = srhs_example, baseline = "central",
                              model_cov = "all", model_int = "all",
                              output = TRUE, fort = TRUE)
print(hm_all)
summary(hm_all)

# Model with a common covariate effect across transitions
hm_const <- est_LM_cat_multinom("srhs1", ~ gender + race + education + age_c,
                                k = 3, data = srhs_example, baseline = "central",
                                model_cov = "const", model_int = "all",
                                output = TRUE, fort = TRUE)
print(hm_const)
summary(hm_const)
}
}
